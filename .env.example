# Áron / Church Translate — secrets. Copy this file to ".env" (same folder) and
# paste your keys. The .env file is git-ignored and never committed.

# Translation — Anthropic Claude. Get a key at https://console.anthropic.com
# (billed per-token, SEPARATE from a Claude.ai Pro subscription).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Speech-to-text — Soniox realtime, multilingual (any of its 60+ languages,
# auto-detected or pinned). Get a key at https://console.soniox.com.
SONIOX_API_KEY=your-soniox-key-here

# Text-to-speech — two interchangeable backends, picked in the app's "Speech"
# dropdown. Whichever have keys are offered; you do not need both.
#
#   ElevenLabs — billed per CHARACTER (~$0.05–0.10 per 1k). Needs the key below
#     plus CT_EL_VOICE. Get a key at https://elevenlabs.io.
#   Soniox     — billed per generated HOUR (~$0.70/hr, roughly 4–8× cheaper),
#     and reuses SONIOX_API_KEY above, so if speech-to-text already works,
#     spoken output does too with nothing further to set up.
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Optional — one ElevenLabs voice id for SPOKEN output. Multilingual voices
# speak whatever target language is chosen in the app, so only one id is
# needed. Leave blank to keep ElevenLabs off. Find ids in your ElevenLabs
# Voice Library.
CT_EL_VOICE=

# Optional — which backend speaks by default: "elevenlabs" (default) or
# "soniox". Ignored if that backend has no key, and overridable live in the
# app. CT_SX_VOICE picks the Soniox built-in voice (a name, e.g. Adrian, Maya,
# Nina — see the app's Voice dropdown for all 70); CT_SX_TTS_MODEL pins the
# model (tts-rt-v2; v1 is deprecated and retired 31 Aug 2026).
CT_TTS_PROVIDER=
CT_SX_VOICE=
CT_SX_TTS_MODEL=

# Optional — how many clips may be synthesizing at the cloud provider at once
# (default 3). Clips always PLAY in order; this only stops one sentence from
# waiting on the previous one's network round trip. Lower it to 1 if a provider
# starts rate-limiting you.
CT_TTS_MAX_INFLIGHT=

# Optional — recording the spoken translation. Every clip the app speaks is
# kept in memory as it is generated, so a whole service can be saved off
# afterwards as ONE mp3 with subtitles timed to it, a timestamped map of every
# clip, and a side-by-side transcript. Nothing is uploaded: the buffer lives in
# this server and is written to your own disk.
#   CT_RECORD           0 to keep the buffer off entirely (default on; the
#                       "Record speech" tick in the app overrides it live)
#   CT_RECORD_AUTOSAVE  0 to stop it saving itself when the app closes
#   CT_RECORD_DIR       where saved services land (default: a "recordings"
#                       folder next to the app)
#   CT_RECORD_MAX_MB    stop buffering past this much audio (default 512, which
#                       is roughly nine hours of speech)
CT_RECORD=
CT_RECORD_AUTOSAVE=
CT_RECORD_DIR=
CT_RECORD_MAX_MB=

# Optional — OpenAI gpt-5.2 as an alternative translator model (same prompt
# and safety hardening; picked in the app's Model dropdown). Get a key at
# https://platform.openai.com. Leave blank to hide the option.
OPENAI_API_KEY=
# The Router (STT panel) uses the same key: OpenAI's Decisions API checks each of
# Soniox's translated segments and sends doubtful ones to the Model picker's
# translator. How long the page waits for that check before showing Soniox's
# text unchecked (ms; 2026-10-08 lab: median 0.12 s; live replay the same day: 0.15-0.33 s,
# ~0.5 s on a cold connection -- 200 let most checks expire; 1200 leaves room for a
# cold connection from farther away. The server's OpenAI calls use the same limit):
CT_ROUTER_TIMEOUT_MS=1200
# The Router's decision model (default gpt-6-luna). Its prompts were measured
# with Luna; another model needs re-measuring (validation/results/2026-10-08-luna-gate/).
# CT_ROUTER_MODEL=gpt-6-luna

# Optional — xAI Grok as alternative translator models (same prompt and safety
# hardening; picked in the app's Model dropdown): grok-4.20-non-reasoning and
# grok-4.3 with its reasoning pinned off. Get a key at https://console.x.ai.
# Leave blank to hide the Grok options.
XAI_API_KEY=

# Optional — Google Gemini as alternative translator models (same prompt and
# safety hardening; picked in the app's Model dropdown). Two are offered:
# gemini-3.5-flash-lite (0.54s to first word, the faster of the two) and
# gemini-3.8-flash (~0.4s slower, but better at rebuilding the hyphens Romanian
# speech-to-text drops: "va dat" -> "v-a dat").
#
# Both are pinned to their LOWEST reasoning level per request: Gemini 3.x models
# think by DEFAULT, which costs ~490 hidden tokens before the first word. That
# pin is absolute for flash-lite (zero thought tokens on every input tested);
# 3.8-flash still thinks briefly on a minority of lines, so prefer flash-lite if
# reasoning must be fully off. See scripts/translate_gemini.py.
# Get a key at https://aistudio.google.com/apikey.
# Leave blank to hide the Gemini options.
GEMINI_API_KEY=

# Optional — Gemini prompt caching. ON by default: the ~3.9K-token system prompt
# is uploaded once and referenced by handle, so each caption is billed for a few
# dozen new tokens instead of the whole prompt again (measured: 99.5% of the
# prompt served from cache). It saves MONEY, not latency — captions come back at
# the same speed either way. Cached content is billed for storage while it
# lives, so the TTL is a small cost knob: longer means fewer rebuilds and more
# idle storage. The cache is built in the background and every failure falls
# back to sending the prompt inline, so this can never cost you a caption.
# Set CT_GEMINI_CACHE=0 to switch it off entirely.
CT_GEMINI_CACHE=
CT_GEMINI_CACHE_TTL=       # seconds the cache lives; default 3600, minimum 120
# "gemini-3.6-flash + hears the caption": Gemini gets each caption's own audio
# beside Soniox's text. If it has no first word within CT_HEARS_FIRST_S seconds
# (default 2.5) the caption goes to CT_HEARS_FALLBACK on the text alone
# (default gpt-6-sol-fast with OPENAI_API_KEY, else claude-haiku-4-5).
CT_HEARS_FIRST_S=
CT_HEARS_FALLBACK=
# Extra speech recognizers ("ears": ElevenLabs Scribe, Gemini Live, OpenAI live)
# listening beside Soniox, ticked in the STT panel's Extra ears group: one live
# session each for the whole stream. A ticked ear's text of each caption goes to
# the translator as a clue and shows as a grey line under it. For a segment the
# Router sends on, the clue waits until each ear has heard the segment out (its
# last word and a word past it), at most CT_EAR_WAIT_MS after the seal (default
# 700; 0 = never wait). On a whole sermon: 26 of 27 real mis-hears right with all
# three ears at 700, 21 not waiting, 20 without ears
# (validation/results/2026-10-09-ear-sermon); longer than 700 gained nothing
# (validation/results/2026-10-10-ear-done).
# Each needs its own API key and is billed for the whole time it listens.
# CT_EARS=0 hides and disables them all.
CT_EARS=
# CT_EAR_WAIT_MS=700

# Optional — stream finalized captions to your own website so people can read the
# translation on their phones anywhere. Point CT_PUBLISH_URL at the publish.php
# you uploaded (see web/captions/README.md) and set CT_PUBLISH_TOKEN to the SAME
# token as in that folder's config.php. Leave blank to hide the "Web" toggle.
CT_PUBLISH_URL=
CT_PUBLISH_TOKEN=

# Optional — also stream the spoken VOICE to that website (viewers tap "Listen"),
# and archive each service's audio. Needs the Web relay above AND TTS configured.
# The clip endpoint is derived automatically as clip.php beside your publish.php,
# so normally you set NOTHING here. Override only if clip.php lives elsewhere.
CT_PUBLISH_CLIP_URL=
# Reject any single relayed clip larger than this many MB (one sentence is tiny).
CT_PUBLISH_CLIP_MAX_MB=4

# Optional — RECOMMENDED way to project onto the auditorium screen through
# ProPresenter: point a ProPresenter web object (or media/browser box) at
# http://<operator-ip>:5000/projector, and it renders Áron's own caption strip
# directly — the full typewriter reveal, rolling window, and dimmed older
# sentences, none of which the plain-text Message API further below can do.
# Polled from this server (no BroadcastChannel needed), so it works on ANOTHER
# computer too — e.g. the one running ProPresenter. Set a FIXED size (px) so it
# drops cleanly into a media box; 0 = fill the window. CT_PROJECTOR_BG is a CSS
# colour (e.g. black) or "transparent".
CT_PROJECTOR_W=0
CT_PROJECTOR_H=0
CT_PROJECTOR_BG=
# Caption text size in PIXELS. 0 = scale with the window (fine full-screen, but tiny
# in a short lower-third box). For a full-width lower-4th media box, try ~60–90.
# NOTE: ProPresenter's web object renders the page then SCALES it to fit the object,
# so a short object shrinks everything, font included. Keep the ProPresenter web
# object FULL SLIDE HEIGHT and place the strip with the two knobs below instead.
CT_PROJECTOR_FONT_PX=0
# Position the strip inside a full-height page (px): lift it up from the bottom edge,
# and cap its height so it stays inside your lower-third band (oldest rows clip off).
CT_PROJECTOR_BOTTOM_PX=0
CT_PROJECTOR_MAX_H_PX=0
# Left/right margins — the gutter between the caption text and the edges of the strip,
# in pixels. 0 = the default 6% of the window width on each side. Set them to line the
# caption up with a lower-third graphic, or to tighten it into a fixed box.
CT_PROJECTOR_LEFT_PX=0
CT_PROJECTOR_RIGHT_PX=0
# What the projector shows and how fast it moves. By default it is a rolling window:
# LINES lines stay on the wall, the previous sentences kept (dimmed) above the reading
# line until they scroll off the top. DWELL_MS holds each line a beat before it scrolls
# up, so a large paragraph does not fly past too fast to read (0 = off, scroll freely).
# LATEST_ONLY=1 instead keeps ONLY the message being read, retiring earlier sentences —
# off by default because retiring a short previous sentence mid-line makes the next one
# jump from the right of the line to the left.
# NOTE: DWELL_MS and the reveal speed are STARTUP DEFAULTS only — the "Wall" knobs in
# the operator header (next to Project) change the per-line hold and the words-per-second
# reveal live, and that choice (kept in the caption store) overrides these for every
# projector, including ones opened later or on another machine.
CT_PROJECTOR_LATEST_ONLY=0
CT_PROJECTOR_LINES=3
CT_PROJECTOR_DWELL_MS=1000
# How many of the most recent sentences stay BRIGHT on the wall; older ones showing
# are dimmed. 12 (default) is effectively "all" — the wall is only a few lines tall, so
# nothing dims and the strip reads as one calm colour. Lower it to keep only the last
# N sentences bright and dim the rest for emphasis. The "Wall" header knob (all bright /
# 1 / 2 / 3) changes it live; this is just the startup default.
CT_PROJECTOR_HIGHLIGHT=12
# How long a caption stays servable to a projector, in seconds. A projector opened
# mid-service otherwise loads on the last 40 segments in the store — the sound check
# from twenty minutes earlier, or the words from before a break. Nothing on the wall
# is worth reading a minute after it was said, so a segment older than this is
# dropped by the feed before anyone sees it. 0 keeps everything until Clear.
CT_PROJECTOR_STALE_S=60

# Optional — ALTERNATIVE way to project, for a ProPresenter that can't host a web
# object (an older version, or a locked-down show): push the finalized translation
# onto the auditorium screen through ProPresenter's on-screen Message instead, over
# whatever ProPresenter is already showing. A Message can only hold plain text, so
# this path can't do the typewriter/dimming effects the projector page above gets
# for free — it can still do a rolling word-by-word window, see CT_PROPRESENTER_TYPE
# below. In ProPresenter: enable Preferences > Network (note the host:port), and
# create a Message with one text token. Then set these and restart; a "ProPresenter"
# toggle appears in the top bar. Leave blank to hide it. See the README's "Projecting
# to ProPresenter" for the walkthrough.
CT_PROPRESENTER_URL=          # http://<propresenter-ip>:<port>, e.g. http://192.168.1.50:1025
CT_PROPRESENTER_MESSAGE=      # the Message's name, uuid, or index in ProPresenter
CT_PROPRESENTER_TOKEN=Caption # the text token's name inside that Message

# Optional — SIGNAL-ONLY mode: use this Message alongside the recommended
# web-object page above (both configured) to get a ProPresenter-side ON/OFF
# flag for the translation box, instead of having the Message carry real
# caption text (which the web object already shows). The browser triggers the
# Message with a fixed "." the moment the box should be showing, and clears it
# the moment it should be hidden — wire a prop/layer's visibility to that
# Message's active state in ProPresenter (or a macro's own Trigger/Clear
# actions) to actually show/hide something from it. Off by default, so the
# Message keeps carrying real text as the ALTERNATIVE's own display (no web
# object in use) unless you opt in. The CT_PROPRESENTER_TYPE rolling-window
# knobs below do not apply in signal mode — there is no text to roll.
CT_PROPRESENTER_SIGNAL=0      # 0 = Message carries real caption text (default) | 1 = Message is an on/off signal only

# Optional — stream the projected caption as a continuous, word-by-word rolling
# lower third that stays FULL, instead of replacing the whole line each caption
# (which flashes a short sentence up and then blanks the box). Only affects the
# ProPresenter Message projection above. Leave CT_PROPRESENTER_TYPE=off for the
# original whole-line behaviour; set it to "word" for the rolling window: each
# finalized caption's words flow in a word every CT_PROPRESENTER_TYPE_MS, the lines
# fill and stay full, and the top line scrolls up as the next fills.
#   In ProPresenter, for "word" mode: make the Message's text box CT_PROPRESENTER_LINES
#   rows tall, BOTTOM-ALIGNED, "Shrink text to fit" OFF, and theme transitions NONE
#   (rapid re-triggers would otherwise re-run the build animation and flicker). The
#   previous line moves up on its own as a new one fills below it. LINES/COLS apply
#   only in "word" mode.
CT_PROPRESENTER_TYPE=off        # off | word
CT_PROPRESENTER_TYPE_MS=120     # milliseconds between word reveals
CT_PROPRESENTER_TYPE_WORDS=1    # words revealed per step (raise for a faster/chunkier reveal)
CT_PROPRESENTER_LINES=2         # caption lines (the rolling window height = box rows)
CT_PROPRESENTER_COLS=42         # approx. characters per line, for wrapping/rolling
CT_PROPRESENTER_SCROLL_MS=0     # retired (kept for back-compat); rolling needs no extra frame

# Optional — where `python scripts/deploy_captions.py` uploads the web/captions/
# relay files. Only needed if you use that script to publish updates to the host
# (you can also upload the folder by hand / FTP). Requires SSH KEY auth to the
# host (no password). The script never overwrites config.php or your live data.
CT_DEPLOY_SSH=            # user@host, e.g. me@example.com
CT_DEPLOY_PATH=           # remote dir, e.g. public_html/captions
CT_DEPLOY_PORT=22         # optional, default 22

# Advanced -- the defaults are the measured choices; set one only to try another.
# CT_SONIOX_MODEL=stt-rt-v5          # Soniox realtime model
# CT_EL_TTS_MODEL=eleven_v4_turbo    # ElevenLabs voice model when the page names none
# CT_UNSURE_BELOW=0.5                # Soniox confidence under which a word is marked unsure for the translator (0 = off)
# CT_LOG_MT_INPUT=0                  # 1 = print each translation's full source text in the console
# CT_PORT=5000                       # the server's port (the Windows launcher sets its own)
# CT_OPEN=1                          # 0 = don't open the browser at start (Windows only)
