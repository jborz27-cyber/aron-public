# Never serve the store or the token config as downloadable files. PHP is always
# executed (never shown as source), but denying direct access is a cheap second
# line of defence. Apache 2.4 syntax (Bluehost); the <IfModule> keeps it inert
# on the off chance mod_authz_core is unavailable.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(json)$">
    Require all denied
  </FilesMatch>
  <Files "config.php">
    Require all denied
  </Files>
</IfModule>
